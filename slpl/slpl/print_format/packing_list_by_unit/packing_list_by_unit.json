 "css": "table {\n    width:100%;\n    color:black; \n    table-layout:fixed; \n    border:1px solid black; \n}\n\n.print-format th {\n    border:1px solid black;\n    background:white !important;\n    color:black;\n}\n\n.print-format td {\n    border:1px solid black;\n    background:white !important;\n    color:black;\n}",
