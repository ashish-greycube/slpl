 "doc_type": "Packing List MW",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "<!DOCTYPE html>\n<html>\n<head>\n    <style>\n        table {\n            width: 100%;\n            border-collapse: collapse;\n            table-layout: fixed;\n            font-family: Arial, sans-serif;\n        }\n        td, th {\n            padding: 4px 6px;\n        }\n        th {\n            font-size: 0.8rem;\n            text-align: center;\n        }\n    </style>\n</head>\n<body>\n    <table>\n        <colgroup>\n            <col style=\"width: 5%;\">   <!-- 1: SR No -->\n            <col style=\"width: 12%;\">  <!-- 2: Item Code -->\n            <col style=\"width: 25%;\">  <!-- 3: Description -->\n            <col style=\"width: 5%;\">   <!-- 4: Qty -->\n            <col style=\"width: 7%;\">   <!-- 5: Length -->\n            <col style=\"width: 7%;\">   <!-- 6: Width -->\n            <col style=\"width: 7%;\">   <!-- 7: Height -->\n            <col style=\"width: 8%;\">   <!-- 8: GROSS -->\n            <col style=\"width: 6%;\">   <!-- 9: NET -->\n            <col style=\"width: 7%;\">   <!-- 10: Unit -->\n            <col style=\"width: 10%;\">  <!-- 11: Packaging Type -->\n        </colgroup>\n        <tbody>\n            <tr>\n                <td colspan=\"2\">\n                    <img src=\"/files/MWI New Logo.jpg\" style=\"width: 100px; max-width: 100%;\" />\n                </td>\n                <td colspan=\"9\" style=\"font-size: 1rem; text-align: center; vertical-align: middle !important;\">\n                    {{ get_company_address() }}\n                </td>\n            </tr>\n\n            <tr>\n                <td colspan=\"2\" style=\"text-align: center; font-weight: bold; font-size: 0.8rem;\">\n                    ISO 9001 : 2015\n                </td>\n                <td colspan=\"9\" style=\"text-align: center; font-weight: bold; font-size: 0.8rem;\">\n                    PACKING LIST\n                </td>\n            </tr>\n\n            <tr>\n                <td colspan=\"2\" style=\"text-align: left; font-weight: bold; font-size: 0.8rem;\">\n                    Project\n                </td>\n                <td colspan=\"9\" style=\"text-align: left; font-size: 0.8rem;\">\n                    {{ doc.customer }}\n                </td>\n            </tr>\n\n            <tr>\n                <td colspan=\"2\" style=\"text-align: left; font-weight: bold; font-size: 0.8rem;\">\n                    Destination\n                </td>\n                <td colspan=\"9\" style=\"text-align: left; font-size: 0.8rem;\">\n                    {{ doc.destination }}\n                </td>\n            </tr>\n\n            <tr>\n                <td colspan=\"2\" style=\"text-align: left; font-weight: bold; font-size: 0.8rem;\">\n                    Invoice No\n                </td>\n                <td colspan=\"3\" style=\"text-align: left; font-size: 0.8rem;\">\n                    {{ doc.name }}\n                </td>\n                <td colspan=\"3\" style=\"text-align: left; font-weight: bold; font-size: 0.8rem;\">\n                    Invoice Date\n                </td>\n                <td colspan=\"3\" style=\"text-align: left; font-size: 0.8rem;\">\n                    {{ doc.date }}\n                </td>\n            </tr>\n\n            <tr>\n                <td colspan=\"2\" style=\"text-align: left; font-weight: bold; font-size: 0.8rem;\">\n                    Sales Order No\n                </td>\n                <td colspan=\"3\" style=\"text-align: left; font-size: 0.8rem;\">\n                    {{ doc.sales_order }}\n                </td>\n                <td colspan=\"3\" style=\"text-align: left; font-weight: bold; font-size: 0.8rem;\">\n                    Sales Order Date\n                </td>\n                <td colspan=\"3\" style=\"text-align: left; font-size: 0.8rem;\">\n                    {{ doc.sales_order_date }}\n                </td>\n            </tr>\n\n            <tr>\n                <td colspan=\"2\" style=\"text-align: left; font-weight: bold; font-size: 0.8rem;\">\n                    ACK No\n                </td>\n                <td colspan=\"3\" style=\"text-align: left; font-size: 0.8rem;\">\n                    {{ doc.ack_no }}\n                </td>\n                <td colspan=\"3\" style=\"text-align: left; font-weight: bold; font-size: 0.8rem;\">\n                    Vehicle No\n                </td>\n                <td colspan=\"3\" style=\"text-align: left; font-size: 0.8rem;\">\n                    {{ doc.vehicle_no }}\n                </td>\n            </tr>\n\n            <tr>\n                <td colspan=\"2\" style=\"text-align: left; font-weight: bold; font-size: 0.8rem;\">\n                    Product Name\n                </td>\n                <td colspan=\"3\" style=\"text-align: left; font-size: 0.8rem;\">\n                    {{ doc.product_name }}\n                </td>\n                <td colspan=\"3\" style=\"text-align: left; font-weight: bold; font-size: 0.8rem;\">\n                    LR No\n                </td>\n                <td colspan=\"3\" style=\"text-align: left; font-size: 0.8rem;\">\n                    {{ doc.lr_no }}\n                </td>\n            </tr>\n\n            <tr>\n                <td colspan=\"2\" style=\"text-align: left; font-weight: bold; font-size: 0.8rem;\">\n                    Quantity\n                </td>\n                <td colspan=\"3\" style=\"text-align: left; font-size: 0.8rem;\">\n                    {{ doc.quantity }}\n                </td>\n                <td colspan=\"3\" style=\"text-align: left; font-weight: bold; font-size: 0.8rem;\">\n                    MDCC\n                </td>\n                <td colspan=\"3\" style=\"text-align: left; font-size: 0.8rem;\">\n                    {{ doc.mdcc }}\n                </td>\n            </tr>\n\n            <!-- Item Table Headers -->\n            <tr>\n                <th>SR No</th>\n                <th>Item Code</th>\n                <th>Description</th>\n                <th>Qty</th>\n                <th>Length</th>\n                <th>Width</th>\n                <th>Height</th>\n                <th>GROSS</th>\n                <th>NET</th>\n                <th>Unit</th>\n                <th>Packaging Type</th>\n            </tr>\n\n            {% set table_data, total_boxes = get_table_data(doc.packing_items) %}\n            {% for item in table_data %}\n                <tr>\n                    <td>{{ loop.index }}</td>\n                    <td>{{ item.item_code }}</td>\n                    <td>{{ item.description }}</td>\n                    <td>{{ item.qty }}</td>\n                    {% if item.rowspan %}\n                        <td rowspan=\"{{ item.rowspan }}\" style=\"text-align: center; vertical-align: middle;\">{{ item.total_length }}</td>\n                        <td rowspan=\"{{ item.rowspan }}\" style=\"text-align: center; vertical-align: middle;\">{{ item.total_width }}</td>\n                        <td rowspan=\"{{ item.rowspan }}\" style=\"text-align: center; vertical-align: middle;\">{{ item.total_height }}</td>\n                        <td rowspan=\"{{ item.rowspan }}\" style=\"text-align: center; vertical-align: middle;\">{{ item.total_gross }}</td>\n                        <td rowspan=\"{{ item.rowspan }}\" style=\"text-align: center; vertical-align: middle;\">{{ item.total_net }}</td>\n                        <td rowspan=\"{{ item.rowspan }}\" style=\"text-align: center; vertical-align: middle;\">{{ item.unit }}</td>\n                        <td rowspan=\"{{ item.rowspan }}\" style=\"text-align: center; vertical-align: middle;\">{{ item.packaging_type }}</td>\n                    {% endif %}\n                </tr>\n            {% endfor %}\n\n            <tr>\n                <td></td>\n                <td></td>\n                <td style=\"text-align: left; font-weight: bold; font-size: 0.8rem;\">TOTAL</td>\n                <td style=\"text-align: left; font-weight: bold; font-size: 0.8rem;\">{{ doc.packing_items|sum(\"qty\")}}</td>\n                <td></td>\n                <td></td>\n                <td></td>\n                <td style=\"text-align: left; font-weight: bold; font-size: 0.8rem;\">{{ doc.packing_items|sum(\"gross\")}}</td>\n                <td style=\"text-align: left; font-weight: bold; font-size: 0.8rem;\">{{ doc.packing_items|sum(\"net\")}}</td>\n                <td></td>\n                <td></td>\n            </tr>\n\n            <tr>\n                <td></td>\n                <td></td>\n                <td style=\"text-align: left; font-weight: bold; font-size: 0.8rem;\">TOTAL PACKAGES</td>\n                <td colspan=\"8\" style=\"text-align: left; font-weight: bold; font-size: 0.8rem;\">{{ total_boxes }}</td>\n            </tr>\n        </tbody>\n    </table>\n</body>\n</html>",
