{
 "absolute_value": 0,
 "align_labels_right": 0,
 "creation": "2026-08-21 10:00:00",
 "css": ".box-label {\n    color: black;\n}",
 "custom_format": 1,
 "default_print_language": "en",
 "disabled": 0,
 "doc_type": "Packing List MW",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "<!DOCTYPE html>\n<html>\n<head>\n    <style>\n        body {\n            font-family: Arial, sans-serif;\n            font-size: 0.85rem;\n        }\n        .box-label {\n            padding: 8px;\n        }\n        .box-label table {\n            width: 100%;\n            border-collapse: collapse;\n        }\n        .box-label td {\n            vertical-align: top;\n            padding: 4px;\n        }\n        .label-field {\n            margin: 2px 0;\n        }\n        .qr-cell {\n            text-align: center;\n        }\n        .qr-cell img {\n            width: 150px;\n            max-width: 100%;\n        }\n        .footnote {\n            font-size: 0.7rem;\n            font-style: italic;\n            margin-top: 8px;\n        }\n    </style>\n</head>\n<body>\n    {% set boxes = get_boxes(doc.packing_items) %}\n    {% for box in boxes %}\n        {% set item_descriptions = box.packed_items | map(attribute='description') | unique | list %}\n        {% set qr_text = get_qr_table_text(doc.name, box) %}\n        <div class=\"box-label\" style=\"{% if not loop.last %}page-break-after: always;{% endif %}\">\n            <table>\n                <tr>\n                    <td style=\"width: 65%;\">\n                        <div class=\"label-field\"><b>Vendor:</b> {{ doc.customer }}</div>\n                        <div class=\"label-field\"><b>Sub Vendor:</b> {{ item_descriptions | join(', ') }}</div>\n                        <div class=\"label-field\"><b>Qty in Package / MDCC:</b> {{ box.total_qty }}</div>\n                        <div class=\"label-field\"><b>Packaging Type:</b> {{ box.packaging_type }}</div>\n                        <div class=\"label-field\"><b>Package No:</b> {{ box.unit }}</div>\n                        <!-- TODO: map this line - source unclear (e.g. \"2100169106/ Packinglist706/ Wooden Box/\") -->\n                        <div class=\"label-field\"></div>\n                        <div class=\"label-field\"><b>Description:</b> {{ doc.product_name }}</div>\n                        <div class=\"label-field\"><b>Sub Descripton:</b> {{ item_descriptions | join(', ') }}</div>\n                        <div class=\"label-field\"><b>MDCC:</b> {{ doc.mdcc }}</div>\n                        <div class=\"footnote\">*PL and MDCC quantities may not match. (PLID: {{ doc.name }})</div>\n                    </td>\n                    <td class=\"qr-cell\" style=\"width: 35%;\">\n                        <img src=\"data:image/png;base64,{{ get_qr_code(qr_text) }}\" />\n                        <div><b>PLID:</b> {{ doc.name }}</div>\n                    </td>\n                </tr>\n            </table>\n        </div>\n    {% endfor %}\n</body>\n</html>",
 "idx": 0,
 "line_breaks": 0,
 "margin_bottom": 15.0,
 "margin_left": 15.0,
